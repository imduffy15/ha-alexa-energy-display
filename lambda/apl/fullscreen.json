{
  "type": "APL",
  "version": "2024.1",
  "theme": "dark",
  "background": "#0B1220",
  "description": "Full-screen energy view. datasources.energy = snapshot + layout from lambda/views.py. The parameter must not be named 'payload': APL binds the whole datasources object to a lone 'payload' parameter. Works back to APL 1.3; views.py sets 'version' per device.",
  "settings": {
    "idleTimeout": 600000
  },
  "mainTemplate": {
    "parameters": [
      "energy"
    ],
    "items": [
      {
        "type": "Frame",
        "width": "100vw",
        "height": "100vh",
        "backgroundColor": "#0B1220",
        "handleTick": [
          {
            "minimumDelay": "${energy.refreshMs}",
            "commands": [
              {
                "type": "SendEvent",
                "arguments": [
                  "refresh"
                ]
              }
            ]
          }
        ],
        "item": {
          "type": "Container",
          "width": "100vw",
          "height": "100vh",
          "paddingLeft": "${energy.sidePadding}",
          "paddingRight": "${energy.sidePadding}",
          "paddingTop": "${energy.topPadding}",
          "paddingBottom": "${energy.bottomPadding}",
          "items": [
            {
              "type": "Container",
              "direction": "row",
              "justifyContent": "spaceBetween",
              "alignItems": "center",
              "width": "100%",
              "height": "10vh",
              "paddingLeft": "1vh",
              "paddingRight": "1vh",
              "items": [
                {
                  "type": "Text",
                  "text": "${energy.title}",
                  "color": "#FFFFFF",
                  "fontSize": "${energy.headSize}",
                  "fontWeight": "bold",
                  "maxLines": 1,
                  "shrink": 1
                },
                {
                  "type": "Text",
                  "when": "${energy.showUpdated}",
                  "text": "Updated ${energy.updated}",
                  "color": "#7F8EA6",
                  "fontSize": "${energy.updatedSize}",
                  "maxLines": 1
                }
              ]
            },
            {
              "type": "Container",
              "when": "${energy.status == 'ok'}",
              "width": "100%",
              "height": "${energy.bodyHeight}",
              "data": "${energy.rows}",
              "item": {
                "type": "Container",
                "width": "100%",
                "height": "${energy.rowHeight}",
                "direction": "row",
                "data": "${data}",
                "item": {
                  "type": "Container",
                  "width": "${energy.tileWidth}",
                  "height": "100%",
                  "padding": "${energy.cellPad}",
                  "bind": [
                    {
                      "name": "tile",
                      "value": "${data}"
                    }
                  ],
                  "items": [
                    {
                      "type": "Frame",
                      "width": "100%",
                      "height": "100%",
                      "backgroundColor": "#141D2E",
                      "borderRadius": "2vh",
                      "item": {
                        "type": "Container",
                        "width": "100%",
                        "height": "100%",
                        "direction": "row",
                        "items": [
                          {
                            "type": "Frame",
                            "width": "0.8vh",
                            "height": "100%",
                            "backgroundColor": "${tile.color}",
                            "borderRadius": "2vh"
                          },
                          {
                            "type": "Container",
                            "width": "100%",
                            "height": "100%",
                            "shrink": 1,
                            "paddingLeft": "${energy.innerPad}",
                            "paddingRight": "${energy.innerPad}",
                            "justifyContent": "center",
                            "items": [
                              {
                                "type": "Text",
                                "text": "${tile.label}",
                                "color": "#A9B7CC",
                                "fontSize": "${energy.labelSize}",
                                "maxLines": 1
                              },
                              {
                                "type": "Container",
                                "direction": "row",
                                "alignItems": "end",
                                "items": [
                                  {
                                    "type": "Text",
                                    "text": "${tile.value}",
                                    "color": "${tile.color}",
                                    "fontSize": "${energy.valueSize}",
                                    "fontWeight": "bold",
                                    "maxLines": 1
                                  },
                                  {
                                    "type": "Text",
                                    "text": "${tile.unit}",
                                    "color": "#DDE5F0",
                                    "fontSize": "${energy.labelSize}",
                                    "paddingLeft": "1vh",
                                    "paddingBottom": "0.6vh",
                                    "maxLines": 1
                                  }
                                ]
                              },
                              {
                                "type": "Text",
                                "when": "${tile.sub}",
                                "text": "${tile.sub}",
                                "color": "#7F8EA6",
                                "fontSize": "${energy.subSize}",
                                "maxLines": 1
                              },
                              {
                                "type": "Container",
                                "when": "${tile.percent != null}",
                                "width": "100%",
                                "paddingTop": "1vh",
                                "items": [
                                  {
                                    "type": "Frame",
                                    "width": "100%",
                                    "height": "1.2vh",
                                    "backgroundColor": "#24304A",
                                    "borderRadius": "1vh",
                                    "item": {
                                      "type": "Frame",
                                      "width": "${tile.percent}%",
                                      "height": "100%",
                                      "backgroundColor": "${tile.color}",
                                      "borderRadius": "1vh"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            },
            {
              "type": "Container",
              "when": "${energy.status != 'ok'}",
              "width": "100%",
              "height": "${energy.bodyHeight}",
              "justifyContent": "center",
              "alignItems": "center",
              "items": [
                {
                  "type": "Text",
                  "text": "${energy.message}",
                  "color": "#A9B7CC",
                  "fontSize": "4.5vh",
                  "textAlign": "center",
                  "width": "80vw"
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
