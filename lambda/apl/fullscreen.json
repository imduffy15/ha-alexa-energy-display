{
  "type": "APL",
  "version": "2024.1",
  "theme": "dark",
  "background": "#0B1220",
  "description": "Full-screen energy view. datasources.payload = snapshot + layout hints from lambda/views.py.",
  "settings": {
    "idleTimeout": 600000
  },
  "mainTemplate": {
    "parameters": [
      "payload"
    ],
    "items": [
      {
        "type": "Frame",
        "width": "100vw",
        "height": "100vh",
        "backgroundColor": "#0B1220",
        "handleTick": [
          {
            "minimumDelay": "${payload.refreshMs}",
            "commands": [
              {
                "type": "SendEvent",
                "arguments": [
                  "refresh"
                ]
              }
            ]
          }
        ],
        "item": {
          "type": "Container",
          "width": "100%",
          "height": "100%",
          "paddingLeft": "3vw",
          "paddingRight": "3vw",
          "paddingTop": "3vh",
          "paddingBottom": "3vh",
          "items": [
            {
              "type": "Container",
              "direction": "row",
              "justifyContent": "spaceBetween",
              "alignItems": "center",
              "width": "100%",
              "height": "10vh",
              "paddingLeft": "1vh",
              "paddingRight": "1vh",
              "items": [
                {
                  "type": "Text",
                  "text": "${payload.title}",
                  "color": "#FFFFFF",
                  "fontSize": "6vh",
                  "fontWeight": "bold",
                  "maxLines": 1,
                  "shrink": 1
                },
                {
                  "type": "Text",
                  "text": "Updated ${payload.updated}",
                  "color": "#7F8EA6",
                  "fontSize": "3.5vh",
                  "maxLines": 1
                }
              ]
            },
            {
              "type": "Container",
              "when": "${payload.status == 'ok'}",
              "width": "100%",
              "height": "84vh",
              "direction": "row",
              "wrap": "wrap",
              "data": "${payload.tiles}",
              "item": {
                "type": "Container",
                "width": "${payload.tileWidth}",
                "height": "${payload.tileHeight}",
                "padding": "1vh",
                "bind": [
                  {
                    "name": "tile",
                    "value": "${data}"
                  }
                ],
                "items": [
                  {
                    "type": "Frame",
                    "width": "100%",
                    "height": "100%",
                    "backgroundColor": "#141D2E",
                    "borderRadius": "2vh",
                    "item": {
                      "type": "Container",
                      "width": "100%",
                      "height": "100%",
                      "direction": "row",
                      "items": [
                        {
                          "type": "Frame",
                          "width": "0.8vh",
                          "height": "100%",
                          "backgroundColor": "${tile.color}",
                          "borderRadius": "2vh"
                        },
                        {
                          "type": "Container",
                          "width": "100%",
                          "height": "100%",
                          "shrink": 1,
                          "paddingLeft": "2.5vh",
                          "paddingRight": "2vh",
                          "justifyContent": "center",
                          "items": [
                            {
                              "type": "Text",
                              "text": "${tile.label}",
                              "color": "#A9B7CC",
                              "fontSize": "${payload.labelSize}",
                              "maxLines": 1
                            },
                            {
                              "type": "Container",
                              "direction": "row",
                              "alignItems": "baseline",
                              "items": [
                                {
                                  "type": "Text",
                                  "text": "${tile.value}",
                                  "color": "${tile.color}",
                                  "fontSize": "${payload.valueSize}",
                                  "fontWeight": "bold",
                                  "maxLines": 1
                                },
                                {
                                  "type": "Text",
                                  "text": "${tile.unit}",
                                  "color": "#DDE5F0",
                                  "fontSize": "${payload.labelSize}",
                                  "paddingLeft": "1vh",
                                  "maxLines": 1
                                }
                              ]
                            },
                            {
                              "type": "Text",
                              "when": "${tile.sub}",
                              "text": "${tile.sub}",
                              "color": "#7F8EA6",
                              "fontSize": "${payload.subSize}",
                              "maxLines": 1
                            },
                            {
                              "type": "Container",
                              "when": "${tile.percent != null}",
                              "width": "100%",
                              "paddingTop": "1vh",
                              "items": [
                                {
                                  "type": "Frame",
                                  "width": "100%",
                                  "height": "1.2vh",
                                  "backgroundColor": "#24304A",
                                  "borderRadius": "1vh",
                                  "item": {
                                    "type": "Frame",
                                    "width": "${tile.percent}%",
                                    "height": "100%",
                                    "backgroundColor": "${tile.color}",
                                    "borderRadius": "1vh"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "type": "Container",
              "when": "${payload.status != 'ok'}",
              "width": "100%",
              "height": "84vh",
              "justifyContent": "center",
              "alignItems": "center",
              "items": [
                {
                  "type": "Text",
                  "text": "${payload.message}",
                  "color": "#A9B7CC",
                  "fontSize": "4.5vh",
                  "textAlign": "center",
                  "width": "80vw"
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
